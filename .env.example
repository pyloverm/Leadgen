# Aucune clé d'API n'est nécessaire : tout fonctionne avec des sources gratuites.
# Ces réglages avancés sont optionnels.

# Serveurs Overpass (OpenStreetMap), séparés par des virgules, essayés dans l'ordre.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Serveur de géocodage Nominatim.
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# User-Agent envoyé aux services OpenStreetMap et à l'Internet Archive (mettez-y votre email de contact).
# LEADGEN_USER_AGENT=LeadGenPortugal/1.0 (contact: vous@example.com)
