# Toutes les variables sont optionnelles : sans rien, l'app utilise OpenStreetMap (gratuit).

# Google Places API (New) — couverture bien meilleure (sites web, téléphones, avis).
# Console Google Cloud > APIs & Services > activer "Places API (New)" > créer une clé.
GOOGLE_PLACES_API_KEY=

# Nombre maximum de requêtes Google par recherche (protège votre facture). Défaut : 60.
GOOGLE_MAX_REQUESTS=60

# Clé Google PageSpeed Insights (bouton "PageSpeed" dans la fiche d'un commerce).
# Sans clé ça marche aussi, mais avec un quota très faible.
PAGESPEED_API_KEY=

# Avancé : serveurs Overpass (OpenStreetMap) séparés par des virgules, et User-Agent envoyé.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# LEADGEN_USER_AGENT=LeadGenPortugal/1.0 (contact: vous@example.com)
